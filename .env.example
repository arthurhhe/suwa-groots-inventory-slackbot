# Copy to .env.local (or let `npm run setup` write it). Never commit real values.

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_CHANNEL_ID=C0123456789

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5

# Microsoft Graph (app-only, scoped to ONE workbook via Files.SelectedOperations.Selected)
MS_TENANT_ID=...
MS_CLIENT_ID=...
MS_CLIENT_SECRET=...
MS_DRIVE_ID=...
MS_ITEM_ID=...
# Optional: worksheet name. Defaults to the first sheet.
WORKSHEET_NAME=

# Upstash Redis (Vercel Marketplace). Used for Slack event dedupe, pending confirmations, column-map cache.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional guardrail overrides
MAX_CELLS_PER_REQUEST=10
CONFIRM_CHANGE_ABOVE_UNITS=1000
CONFIRM_CHANGE_RATIO=10
