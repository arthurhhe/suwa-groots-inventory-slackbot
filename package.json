{
  "name": "inventory-slack-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Slack bot that updates an inventory workbook in OneDrive/SharePoint and posts low-stock alerts",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/doctor.ts",
    "make-template": "tsx scripts/make-template.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@slack/web-api": "^8.2.0",
    "@upstash/redis": "^1.40.0",
    "mustache": "^4.2.0",
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
